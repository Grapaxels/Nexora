{
  "name": "nexora-campus-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,white \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
