    "lucide-react": "^0.468.0",
    "express": "^5.1.0",
    "dotenv": "^16.5.0",
    "mongodb": "^6.16.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^10.1.4"
  }
}
