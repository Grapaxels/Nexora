PORT=3001
APP_ORIGIN=https://nexora.grapaxels.in
CAMPUS_NAME=Lovely Professional University
NODE_ENV=production

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net
MONGODB_DB=Nexora

# Use either SMTP or Resend. SMTP takes priority when SMTP_HOST is set.
RESEND_API_KEY=
MAIL_FROM=Nexora <you@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_HELO=localhost
SMTP_USER=you@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=Nexora <you@gmail.com>

ADMIN_EMAILS=you@gmail.com

# Single-domain deployment: the browser calls /api on APP_ORIGIN.
# Leave VITE_API_URL empty. API_PUBLIC_ORIGIN is optional and kept only for
# compatibility with older stored upload URLs.
API_PUBLIC_ORIGIN=https://nexora.grapaxels.in
VITE_API_URL=

SUPER_ADMIN_EMAIL=you@gmail.com
SUPER_ADMIN_PASSWORD_HASH=scrypt$YOUR_SALT$YOUR_HASH
