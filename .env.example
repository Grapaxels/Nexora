PORT=3001
APP_ORIGIN=http://localhost:5173
CAMPUS_NAME=Nexora University
NODE_ENV=development
DEMO_MODE=true
# Leave URI empty in development to start a real local MongoDB process automatically.
# Use mongodb://127.0.0.1:27017 or your MongoDB Atlas connection string to use your own server.
MONGODB_URI=
MONGODB_DB=Nexora
RESEND_API_KEY=
MAIL_FROM=Nexora <noreply@yourcollege.edu>
# SMTP is used before Resend when SMTP_HOST is set. Use an app password, never your normal mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_HELO=localhost
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nexora <noreply@yourcollege.edu>
ADMIN_EMAILS=
